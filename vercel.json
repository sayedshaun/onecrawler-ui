{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "https://yokelish-aperiodically-drucilla.ngrok-free.dev/api/$1"
    },
    {
      "source": "/agents-api/(.*)",
      "destination": "https://yokelish-aperiodically-drucilla.ngrok-free.dev/agents/api/$1"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}